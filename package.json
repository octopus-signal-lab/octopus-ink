{
  "name": "octopus-ink",
  "version": "0.1.0",
  "private": true,
  "description": "Octopus Ink — local Markdown viewer/editor (OctoSignal Lab). 100% client-side.",
  "scripts": {
    "predev": "node scripts/ensure-port.mjs",
    "dev": "next dev -p 3008",
    "prebuild": "node scripts/clean-next-output.mjs",
    "build": "next build",
    "prebuild:tauri:web": "node scripts/clean-next-output.mjs",
    "build:tauri:web": "cross-env TAURI_BUILD=1 next build && node scripts/assert-tauri-entry.mjs",
    "start": "next start -p 3008",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "dompurify": "^3.4.11",
    "mammoth": "^1.12.0",
    "marked": "^12.0.2",
    "next": "^15.5.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "turndown": "^7.1.3",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.4"
  }
}
