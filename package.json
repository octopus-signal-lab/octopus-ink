{
  "name": "octopus-ink",
  "version": "0.1.0",
  "private": true,
  "description": "Octopus Ink — local Markdown viewer/editor (OctoSignal Lab). 100% client-side.",
  "scripts": {
    "predev": "node scripts/ensure-port.mjs",
    "dev": "next dev -p 3008",
    "build": "next build",
    "start": "next start -p 3008",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "mammoth": "^1.12.0",
    "marked": "^12.0.2",
    "next": "15.5.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "turndown": "^7.1.3",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
