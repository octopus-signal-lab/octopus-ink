{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Octopus Ink",
  "version": "0.1.0",
  "identifier": "org.octosignal.ink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri:web",
    "devUrl": "http://localhost:3008",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Octopus Ink",
        "label": "main",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self'; connect-src ipc: http://ipc.localhost; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "publisher": "OctoSignal Lab",
    "category": "Productivity",
    "copyright": "Copyright © 2026 OctoSignal Lab",
    "icon": ["../public/icon-512.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}

